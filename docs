Penjelasan & Dokumentasi Langkah Pembuatan (Educational Explanation)
Filtering Kolom TERBILANG: Di spreadsheet Anda terdapat kolom Terbilang PAI, Terbilang PP, dll. Kode !title.includes("TERBILANG") memastikan aplikasi hanya mengambil nilai angka (seperti 82, 75, 83) untuk menghitung Rata-Rata dan Total Nilai.
Koneksi Multi-Proxy (Fallback Strategy): Fungsi fetchCSVWithFallback() mencoba mengambil data dari allorigins.win. Jika gagal atau diblokir, ia langsung berganti ke corsproxy.io secara otomatis.
Penyesuaian Kolom Tambahan: Aplikasi kini menampilkan Kelas (dari Kolom C) dan Wali Kelas / WALAS (dari Kolom AA) secara otomatis pada Kartu Hasil Studi siswa!

User prompt: apakah ada perubahan untuk backendnya? saya juga buat di appscript
Response: Iya, ada perubahan dan penyesuaian penting jika Anda ingin menggunakan Google Apps Script sebagai backend/API resmi aplikasi ini.
Menggunakan Google Apps Script sebagai backend adalah pilihan terbaik dan paling aman, karena:
100% Bebas CORS: Aplikasi web Anda di GitHub Pages tidak akan pernah mengalami error Gagal terhubung lagi.
Fleksibel: Anda tidak perlu mempublikasikan file CSV secara terbuka jika tidak ingin; Apps Script bisa langsung membaca isi sheet secara internal.
Respon Cepat (JSON): Apps Script akan mencari data NIS secara langsung dan hanya mengirimkan data 1 siswa saja ke frontend (lebih hemat kuota & cepat).
Overview Solusi (Cara Kerja Google Apps Script Backend)
Backend (Apps Script): Menjadi Web App (REST API) yang menerima parameter nis dari frontend. Apps Script mencari NIS di spreadsheet, mengambil data nilai (serta nama, kelas, dan walas), lalu mengembalikan respon berformat JSON.
Frontend (index.html): Melakukan fetch() sederhana ke URL Web App Apps Script yang Anda buat.
Langkah 1: Kode Backend Google Apps Script
Buka Google Spreadsheet Anda, lalu klik Ekstensi (Extensions) > Apps Script. Hapus semua kode yang ada dan ganti dengan kode Apps Script di bawah ini:
function doGet(e) {
  // Ambil parameter NIS dari request URL (contoh: ?nis=9911)
  var targetNis = e.parameter.nis ? String(e.parameter.nis).trim().replace(/\D/g, "") : "";

  if (!targetNis) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: "Parameter NIS tidak ditemukan."
    })).setMimeType(ContentService.MimeType.JSON);
  }

  // Buka sheet aktif
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();

  if (data.length < 2) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: "Data spreadsheet kosong."
    })).setMimeType(ContentService.MimeType.JSON);
  }

  var headerRow = data[0];
  var nisIdx = -1, namaIdx = -1, kelasIdx = -1, walasIdx = -1;
  var mapelIndices = [];

  // Identifikasi letak kolom berdasarkan header
  for (var i = 0; i < headerRow.length; i++) {
    var title = String(headerRow[i]).trim().toUpperCase();
    if (title === "NIS") nisIdx = i;
    else if (title === "NAMA") namaIdx = i;
    else if (title === "KELAS") kelasIdx = i;
    else if (title === "WALAS" || title.indexOf("WALA") !== -1) walasIdx = i;
    else if (title !== "NO" && title.indexOf("TERBILANG") === -1 && title !== "") {
      mapelIndices.push({ index: i, name: String(headerRow[i]).trim() });
    }
  }

  // Posisi default jika tidak terdeteksi otomatis
  if (nisIdx === -1) nisIdx = 3;  // Kolom D
  if (namaIdx === -1) namaIdx = 1; // Kolom B
  if (kelasIdx === -1) kelasIdx = 2; // Kolom C

  var studentFound = null;

  // Cari NIS di baris data
  for (var r = 1; r < data.length; r++) {
    var row = data[r];
    var currentNis = row[nisIdx] ? String(row[nisIdx]).trim().replace(/\D/g, "") : "";

    if (currentNis === targetNis) {
      var mapelObj = {};
      var totalNilai = 0;
      var jumlahMapel = 0;

      for (var m = 0; m < mapelIndices.length; m++) {
        var item = mapelIndices[m];
        var valRaw = row[item.index];
        if (valRaw !== undefined && valRaw !== null && valRaw !== "") {
          var valNum = parseFloat(String(valRaw).replace(",", "."));
          if (!isNaN(valNum)) {
            mapelObj[item.name] = valNum;
            totalNilai += valNum;
            jumlahMapel++;
          }
        }
      }

      var avg = jumlahMapel > 0 ? (totalNilai / jumlahMapel).toFixed(2) : "0";
      var status = "Sangat Baik";
      if (avg < 70) status = "Perlu Peningkatan";
      else if (avg < 80) status = "Cukup Baik";

      studentFound = {
        nis: currentNis,
        nama: row[namaIdx] ? String(row[namaIdx]).trim() : "-",
        kelas: row[kelasIdx] ? String(row[kelasIdx]).trim() : "-",
        walas: (walasIdx !== -1 && row[walasIdx]) ? String(row[walasIdx]).trim() : "-",
        nilai: mapelObj,
        total: totalNilai,
        avg: avg,
        status: status
      };
      break;
    }
  }

  if (studentFound) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "success",
      data: studentFound
    })).setMimeType(ContentService.MimeType.JSON);
  } else {
    return ContentService.createTextOutput(JSON.stringify({
      status: "not_found",
      message: "NIS " + targetNis + " tidak ditemukan."
    })).setMimeType(ContentService.MimeType.JSON);
  }
}


