        // MASUKKAN WEB APP URL GOOGLE APPS SCRIPT ANDA DI SINI
        const APPS_SCRIPT_URL = "GANTI_DENGAN_URL_DEPLOYMENT_APPS_SCRIPT_ANDA";

        // Tanggal Otomatis
        document.getElementById("tglCetak").innerText = new Date().toLocaleDateString('id-ID', {
            day: 'numeric', month: 'long', year: 'numeric'
        });

        async function cariNilaiSiswa(e) {
            e.preventDefault();
            const inputNis = document.getElementById("nisInput").value.trim().replace(/\D/g, "");

            if (!inputNis) {
                tampilkanAlert("Masukkan NIS yang valid!", "error");
                return;
            }

            tampilkanLoading(true);
            sembunyikanAlert();
            document.getElementById("areaHasil").classList.add("hidden");

            try {
                const response = await fetch(`${APPS_SCRIPT_URL}?nis=${inputNis}`);
                const result = await response.json();

                tampilkanLoading(false);

                if (result.status === "success") {
                    renderDataSiswa(result.data);
                } else if (result.status === "not_found") {
                    tampilkanAlert(`NIS ${inputNis} tidak ditemukan di seluruh sheet kelas.`, "error");
                } else {
                    tampilkanAlert(result.message || "Terjadi kesalahan pada server.", "error");
                }

            } catch (err) {
                console.error("Fetch Error:", err);
                tampilkanLoading(false);
                tampilkanAlert("Gagal terhubung ke server Apps Script. Pastikan koneksi internet lancar.", "error");
            }
        }

        function renderDataSiswa(data) {
            document.getElementById("resNama").innerText = data.nama;
            document.getElementById("resNis").innerText = data.nis;
            document.getElementById("resKelas").innerText = data.kelas;
            document.getElementById("resWalas").innerText = data.walas;
            document.getElementById("resRataRata").innerText = data.avg;
            document.getElementById("resTotal").innerText = data.total;
            document.getElementById("resStatus").innerText = data.status;

            const tbody = document.getElementById("tabelNilaiBody");
            tbody.innerHTML = "";

            for (const [mapel, nilai] of Object.entries(data.nilai)) {
                const persen = Math.min(100, Math.max(0, nilai));
                let colorClass = persen >= 85 ? "bg-emerald-500" : (persen < 70 ? "bg-amber-500" : "bg-blue-600");

                const tr = document.createElement("tr");
                tr.className = "hover:bg-slate-50/80 transition-colors";
                tr.innerHTML = `
                    <td class="py-3 px-4 font-semibold text-slate-800">${mapel}</td>
                    <td class="py-3 px-4 text-center font-bold text-slate-900">${nilai}</td>
                    <td class="py-3 px-4 hidden sm:table-cell">
                        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden border border-slate-200">
                            <div class="${colorClass} h-2 rounded-full" style="width: ${persen}%"></div>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            }

            document.getElementById("areaHasil").classList.remove("hidden");
        }

        function tampilkanLoading(show) {
            document.getElementById("loadingSpinner").classList.toggle("hidden", !show);
        }

        function tampilkanAlert(msg, type) {
            const alertEl = document.getElementById("pesanAlert");
            alertEl.className = `p-4 rounded-xl text-sm font-medium flex items-center gap-3 ${
                type === 'error' ? 'bg-rose-50 border border-rose-200 text-rose-700' : 'bg-emerald-50 border border-emerald-200 text-emerald-700'
            }`;
            alertEl.innerHTML = `<i class="fa-solid fa-circle-exclamation text-base"></i><span>${msg}</span>`;
            alertEl.classList.remove("hidden");
        }

        function sembunyikanAlert() {
            document.getElementById("pesanAlert").classList.add("hidden");
        }
    </script>
