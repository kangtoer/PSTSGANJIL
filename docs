            headerLower === "nama" || 
            headerLower === "kelas" || 
            headerLower === "walas" || 
            headerLower === "total" || 
            headerLower === "rata-rata" ||
            headerLower.startsWith("terbilang")
          ) {
            continue;
          }

          const angkaVal = parseFloat(data[i][j]) || 0;

          // Cari kolom terbilang yang berpasangan di sebelah kanan atau berdasarkan nama
          let hurufVal = "";
          if (j + 1 < headers.length && headersLower[j + 1].startsWith("terbilang")) {
            hurufVal = data[i][j + 1].toString().trim();
          }

          // Format nama mapel agar rapi
          const mapelNama = bersihkanNamaMapel(headerName);

          nilaiMap[mapelNama] = {
            angka: angkaVal,
            huruf: hurufVal || angkaKeTerbilangOtomatis(angkaVal) // Fallback jika terbilang di sheet kosong
          };

          total += angkaVal;
          count++;
        }

        const avg = count > 0 ? (total / count).toFixed(1) : 0;
        
        // Ambil nama wali kelas dari sheet jika ada, atau dari mapping WALI_KELAS
        const walasIdx = headersLower.indexOf("walas");
        let walasNama = (walasIdx !== -1 && data[i][walasIdx]) ? data[i][walasIdx] : (WALI_KELAS[namaSheet] || "Wali Kelas");

        const analisis = buatAnalisisKinerja(nilaiMap);

        dataSiswa = {
          nis: rowNis,
          nama: nama,
          kelas: namaSheet,
          walas: walasNama,
          sekolah: "SMP PGRI 1 Kuwarasan",
          semester: "Ganjil",
          tahunAjaran: "2026/2027",
          total: total,
          avg: avg,
          nilai: nilaiMap,
          analisis: analisis
        };
        break;
      }
    }
    if (dataSiswa) break;
  }

  if (dataSiswa) {
    return buatResponseJSON({ status: "success", data: dataSiswa });
  } else {
    return buatResponseJSON({ status: "not_found", message: "Data NIS tidak ditemukan." });
  }
}

// Format nama mata pelajaran agar standar & rapi
function bersihkanNamaMapel(code) {
  const mapelDict = {
    "pai": "Pendidikan Agama dan Budi Pekerti",
    "pp": "Pendidikan Pancasila",
    "b. indo": "Bahasa Indonesia",
    "bindo": "Bahasa Indonesia",
    "mat": "Matematika",
    "ipa": "Ilmu Pengetahuan Alam",
    "ips": "Ilmu Pengetahuan Sosial",
    "b. ingg": "Bahasa Inggris",
    "b ing": "Bahasa Inggris",
    "pjok": "Pendidikan Jasmani, Olah Raga, dan Kesehatan",
    "inf": "Informatika",
    "pra": "Prakarya",
    "b. jawa": "Muatan Lokal (Bahasa Jawa)",
    "b jawa": "Muatan Lokal (Bahasa Jawa)"
  };

  const key = code.toString().toLowerCase().trim();
  return mapelDict[key] || code;
}

// Analisis Kinerja Khusus Mapel Murni
function buatAnalisisKinerja(nilaiMap) {
  let mapelTinggi = [];
  let mapelRendah = [];

  for (const [mapel, valObj] of Object.entries(nilaiMap)) {
    if (valObj.angka >= 85) {
      mapelTinggi.push(`${mapel} (${valObj.angka})`);
    } else if (valObj.angka < KKTP_STANDAR) {
      mapelRendah.push(`${mapel} (${valObj.angka})`);
    }
  }

  let kelebihan = mapelTinggi.length > 0 
    ? `Siswa menunjukkan penguasaan materi yang sangat baik pada mata pelajaran: ${mapelTinggi.join(", ")}.`
    : "Siswa memiliki potensi akademik yang merata di seluruh mata pelajaran.";

  let kekurangan = mapelRendah.length > 0
    ? `Terdapat mata pelajaran yang masih di bawah KKTP (< ${KKTP_STANDAR}), yaitu: ${mapelRendah.join(", ")}.`
    : "Seluruh mata pelajaran telah mencapai KKTP. Kinerja belajar sudah sangat memuaskan.";

  let tindakanSiswa = mapelRendah.length > 0
    ? "Wajib mengikuti remedial, mengulang materi yang belum tuntas, dan meningkatkan kedisiplinan belajar mandiri."
    : "Pertahankan konsistensi belajar dan bantu rekan sejawat melalui kegiatan belajar bersama.";

  let saranOrangTuaGuru = mapelRendah.length > 0
    ? "Orang tua diharapkan memantau waktu belajar di rumah. Guru mata pelajaran akan memberikan pendampingan belajar khusus."
    : "Orang tua dan guru terus memberikan motivasi positif agar prestasi peserta didik tetap terjaga.";

  return {
    kelebihan: kelebihan,
    kekurangan: kekurangan,
    tindakanSiswa: tindakanSiswa,
    saranOrangTuaGuru: saranOrangTuaGuru
  };
}

// Fallback jika terbilang di spreadsheet kosong
function angkaKeTerbilangOtomatis(n) {
  n = Math.floor(n);
  if (n === 0) return "Nol";
  if (n === 100) return "Seratus";

  const satuan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan", "Sepuluh", "Sebelas"];
  if (n < 12) return satuan[n];
  if (n < 20) return angkaKeTerbilangOtomatis(n - 10) + " Belas";
  if (n < 100) {
    const p = Math.floor(n / 10);
    const s = n % 10;
    return (p === 1 ? "Sepuluh" : satuan[p] + " Puluh") + (s > 0 ? " " + satuan[s] : "");
  }
  return n.toString();
}

function buatResponseJSON(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}


