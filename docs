// Map Wali Kelas berdasarkan Kelas
const WALI_KELAS = {
  "7A": "Nama Wali Kelas 7A, S.Pd.",
  "7B": "Nama Wali Kelas 7B, S.Pd.",
  "8A": "Nama Wali Kelas 8A, S.Pd.",
  "8B": "Catur Pamungkas, S.Pd.",
  "9A": "Nama Wali Kelas 9A, S.Pd.",
  "9B": "Nama Wali Kelas 9B, S.Pd."
};

const KKTP_STANDAR = 70;

function doGet(e) {
  const nisParam = e.parameter.nis;
  if (!nisParam) {
    return buatResponseJSON({ status: "error", message: "Parameter NIS tidak ditemukan." });
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();
  let dataSiswa = null;

  // Cari NIS di seluruh sheet kelas
  for (let sheet of sheets) {
    const data = sheet.getDataRange().getValues();
    if (data.length < 2) continue;

    const headers = data[0].map(h => h.toString().trim().toLowerCase());
    const nisIdx = headers.indexOf("nis");
    const namaIdx = headers.indexOf("nama");

    if (nisIdx === -1 || namaIdx === -1) continue;

    for (let i = 1; i < data.length; i++) {
      const rowNis = data[i][nisIdx].toString().trim().replace(/\D/g, "");
      if (rowNis === nisParam) {
        const nama = data[i][namaIdx];
        const namaSheet = sheet.getName(); // Misal: "8B"
        
        let nilaiMap = {};
        let total = 0;
        let count = 0;

        for (let j = 0; j < headers.length; j++) {
          if (j !== nisIdx && j !== namaIdx && headers[j] !== "kelas" && headers[j] !== "total" && headers[j] !== "rata-rata") {
            const val = parseFloat(data[i][j]) || 0;
            const mapelNama = capitalizeHeader(data[0][j]);
            nilaiMap[mapelNama] = {
              angka: val,
              terbilang: angkaKeTerbilang(val)
            };
            total += val;
            count++;
          }
        }

        const avg = count > 0 ? (total / count).toFixed(1) : 0;
        const walas = WALI_KELAS[namaSheet] || "Wali Kelas";
        const analisis = buatAnalisisKinerja(nilaiMap, parseFloat(avg));

        dataSiswa = {
          nis: rowNis,
          nama: nama,
          kelas: namaSheet,
          walas: walas,
          sekolah: "SMP PGRI 1 Kuwarasan",
          semester: "Ganjil",
          tahunAjaran: "2026/2027",
          total: total,
          avg: avg,
          nilai: nilaiMap,
          analisis: analisis
        };
        break;
      }
    }
    if (dataSiswa) break;
  }

  if (dataSiswa) {
    return buatResponseJSON({ status: "success", data: dataSiswa });
  } else {
    return buatResponseJSON({ status: "not_found", message: "Data siswa tidak ditemukan." });
  }
}

// Fungsi Konversi Angka ke Terbilang Bahasa Indonesia
function angkaKeTerbilang(n) {
  n = Math.floor(n);
  if (n === 0) return "Nol";
  if (n === 100) return "Seratus";

  const satuan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan", "Sepuluh", "Sebelas"];
  
  if (n < 12) return satuan[n];
  if (n < 20) return angkaKeTerbilang(n - 10) + " Belas";
  if (n < 100) {
    const puluhan = Math.floor(n / 10);
    const sisa = n % 10;
    return (puluhan === 1 ? "Sepuluh" : satuan[puluhan] + " Puluh") + (sisa > 0 ? " " + satuan[sisa] : "");
  }
  return n.toString();
}

// Fungsi Analisis Kelebihan, Kekurangan, & Saran
function buatAnalisisKinerja(nilaiMap, avg) {
  let mapelTinggi = [];
  let mapelRendah = [];

  for (const [mapel, valObj] of Object.entries(nilaiMap)) {
    if (valObj.angka >= 85) {
      mapelTinggi.push(`${mapel} (${valObj.angka})`);
    } else if (valObj.angka < KKTP_STANDAR) {
      mapelRendah.push(`${mapel} (${valObj.angka})`);
    }
  }

  let kelebihan = mapelTinggi.length > 0 
    ? `Siswa menunjukkan penguasaan materi yang sangat baik pada mata pelajaran: ${mapelTinggi.join(", ")}.`
    : "Siswa memiliki potensi akademik yang merata di berbagai mata pelajaran.";

  let kekurangan = mapelRendah.length > 0
    ? `Terdapat mata pelajaran yang belum mencapai Kriteria Ketercapaian Tujuan Pembelajaran (KKTP < ${KKTP_STANDAR}), yaitu: ${mapelRendah.join(", ")}.`
    : "Tidak ada mata pelajaran di bawah KKTP. Performa akademik sudah sangat memuaskan.";

  let tindakanSiswa = mapelRendah.length > 0
    ? "Wajib mengikuti program remedial, melakukan review ulang materi yang belum dikuasai, dan menambah jam belajar mandiri."
    : "Pertahankan konsistensi belajar, pertajam pemahaman konsep, dan bantu teman sejawat melalui diskusi kelompok.";

  let saranOrangTuaGuru = mapelRendah.length > 0
    ? "Orang tua diharapkan dapat mendampingi jadwal belajar di rumah dan membatasi penggunaan gawai. Guru mata pelajaran akan memberikan pendampingan khusus serta materi pengayaan tambahan."
    : "Orang tua dan guru diharapkan terus memberikan apresiasi dan motivasi agar semangat belajar peserta didik tetap terjaga dengan konsisten.";

  return {
    kelebihan: kelebihan,
    kekurangan: kekurangan,
    tindakanSiswa: tindakanSiswa,
    saranOrangTuaGuru: saranOrangTuaGuru
  };
}

function capitalizeHeader(text) {
  return text.toString().toLowerCase().replace(/\b\w/g, l => l.toUpperCase());
}

function buatResponseJSON(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}


