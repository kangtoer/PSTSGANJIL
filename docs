        const APPS_SCRIPT_URL = "GANTI_DENGAN_URL_DEPLOYMENT_APPS_SCRIPT_ANDA";

        async function cariNilaiSiswa(e) {
            e.preventDefault();
            const inputNis = document.getElementById("nisInput").value.trim().replace(/\D/g, "");

            if (!inputNis) {
                tampilkanAlert("Masukkan NIS yang valid!", "error");
                return;
            }

            tampilkanLoading(true);
            sembunyikanAlert();
            document.getElementById("areaHasil").classList.add("hidden");

            try {
                const response = await fetch(`${APPS_SCRIPT_URL}?nis=${inputNis}`);
                const result = await response.json();

                tampilkanLoading(false);

                if (result.status === "success") {
                    renderRapot(result.data);
                } else {
                    tampilkanAlert(result.message || "Data NIS tidak ditemukan.", "error");
                }

            } catch (err) {
                tampilkanLoading(false);
                tampilkanAlert("Gagal terhubung ke server. Periksa koneksi internet.", "error");
            }
        }

        function renderRapot(data) {
            document.getElementById("resNama").innerText = data.nama;
            document.getElementById("resKelas").innerText = data.kelas;
            document.getElementById("resKelasTt").innerText = data.kelas;
            document.getElementById("resWalas").innerText = data.walas;

            // Render Deskripsi Analisis
            document.getElementById("resKelebihan").innerText = data.analisis.kelebihan;
            document.getElementById("resKekurangan").innerText = data.analisis.kekurangan;
            document.getElementById("resTindakan").innerText = data.analisis.tindakanSiswa;
            document.getElementById("resSaranOrtu").innerText = data.analisis.saranOrangTuaGuru;

            // Render Tabel Nilai
            const tbody = document.getElementById("tabelNilaiBody");
            tbody.innerHTML = "";

            let index = 1;
            for (const [mapel, valObj] of Object.entries(data.nilai)) {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="py-1 px-2 border border-slate-300 text-center">${index++}</td>
                    <td class="py-1 px-3 border border-slate-300 font-medium">${mapel}</td>
                    <td class="py-1 px-2 border border-slate-300 text-center font-bold ${valObj.angka < 70 ? 'text-rose-600' : ''}">${valObj.angka}</td>
                    <td class="py-1 px-3 border border-slate-300">${valObj.huruf}</td>
                `;
                tbody.appendChild(tr);
            }

            document.getElementById("areaHasil").classList.remove("hidden");
        }

        function tampilkanLoading(show) {
            document.getElementById("loadingSpinner").classList.toggle("hidden", !show);
        }

        function tampilkanAlert(msg, type) {
            const alertEl = document.getElementById("pesanAlert");
            alertEl.className = `p-3 rounded-xl text-xs font-medium ${type === 'error' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-700'}`;
            alertEl.innerText = msg;
            alertEl.classList.remove("hidden");
        }

        function sembunyikanAlert() {
            document.getElementById("pesanAlert").classList.add("hidden");
        }
    </script>
