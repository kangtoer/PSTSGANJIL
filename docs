            document.getElementById("areaHasil").classList.remove("hidden");
        }

        function tampilkanLoading(show) {
            document.getElementById("loadingSpinner").classList.toggle("hidden", !show);
        }

        function tampilkanAlert(msg, type) {
            const alertEl = document.getElementById("pesanAlert");
            alertEl.className = `p-4 rounded-xl text-sm font-medium flex items-center gap-3 ${
                type === 'error' ? 'bg-rose-500/10 border border-rose-500/20 text-rose-400' : 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-400'
            }`;
            alertEl.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i><span>${msg}</span>`;
            alertEl.classList.remove("hidden");
        }

