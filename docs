    <script>
        // URL Publikasi CSV Spreadsheet Anda
        const RAW_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS1hdumZbRrJpTE4tlFd6n5MWph6rzb8ByCg6h5CZLWuxTG0wctY-HkayFbU4Sp4i3_ZHdrdtdbwQsH/pub?output=csv";

        async function fetchCSVWithFallback() {
            // Daftar proxy untuk menghindari masalah CORS
            const proxies = [
                `https://api.allorigins.win/raw?url=${encodeURIComponent(RAW_CSV_URL)}`,
                `https://corsproxy.io/?${encodeURIComponent(RAW_CSV_URL)}`
            ];

            for (const url of proxies) {
                try {
                    const res = await fetch(url);
                    if (res.ok) {
                        const text = await res.text();
                        if (text && text.length > 50) return text;
                    }
                } catch (e) {
                    console.warn("Proxy mencoba yang lain...", url);
                }
            }
            throw new Error("Gagal mengambil data dari Google Sheets melalui proxy.");
        }

        async function cariNilaiSiswa(e) {
            e.preventDefault();
            const inputNis = document.getElementById("nisInput").value.trim().replace(/\D/g, "");

            if (!inputNis) {
                tampilkanAlert("Masukkan NIS yang valid!", "error");
                return;
            }

            tampilkanLoading(true);
            sembunyikanAlert();
            document.getElementById("areaHasil").classList.add("hidden");

            try {
                const csvText = await fetchCSVWithFallback();

                Papa.parse(csvText, {
                    header: false,
                    skipEmptyLines: true,
                    complete: function(results) {
                        prosesDataSpreadsheet(results.data, inputNis);
                    },
                    error: function(err) {
                        console.error("PapaParse Error:", err);
                        tampilkanLoading(false);
                        tampilkanAlert("Gagal memproses struktur CSV.", "error");
                    }
                });

            } catch (err) {
                console.error("Fetch Error:", err);
                tampilkanLoading(false);
                tampilkanAlert("Gagal terhubung ke Google Spreadsheet. Pastikan dokumen telah dipublikasikan ke web.", "error");
            }
        }

        function prosesDataSpreadsheet(rows, inputNis) {
            if (!rows || rows.length < 2) {
                tampilkanLoading(false);
                tampilkanAlert("Spreadsheet kosong atau format tidak sesuai.", "error");
                return;
            }

            const headerRow = rows[0];
            
            // Mencari indeks kolom berdasarkan nama header persis di spreadsheet Anda
            let nisIdx = -1, namaIdx = -1, kelasIdx = -1, walasIdx = -1;
            const mapelIndices = [];

            headerRow.forEach((col, idx) => {
                const title = String(col).trim().toUpperCase();
                if (title === "NIS") nisIdx = idx;
                else if (title === "NAMA") namaIdx = idx;
                else if (title === "KELAS") kelasIdx = idx;
                else if (title === "WALAS" || title.includes("WALA")) walasIdx = idx;
                // Mengambil hanya kolom nilai mata pelajaran (Abaikan kolom "TERBILANG")
                else if (title !== "NO" && !title.includes("TERBILANG")) {
                    mapelIndices.push({ index: idx, name: String(col).trim() });
                }
            });

            // Default jika tidak terdeteksi otomatis
            if (nisIdx === -1) nisIdx = 3;  // Kolom D
            if (namaIdx === -1) namaIdx = 1; // Kolom B
            if (kelasIdx === -1) kelasIdx = 2; // Kolom C

            let dataDitemukan = null;

            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                const rawNis = row[nisIdx] ? String(row[nisIdx]).trim().replace(/\D/g, "") : "";

                if (rawNis === inputNis) {
                    const nama = row[namaIdx] ? String(row[namaIdx]).trim() : "-";
                    const kelas = row[kelasIdx] ? String(row[kelasIdx]).trim() : "-";
                    const walas = (walasIdx !== -1 && row[walasIdx]) ? String(row[walasIdx]).trim() : "-";

                    const mapelObj = {};
                    let totalNilai = 0;
                    let jumlahMapel = 0;

                    mapelIndices.forEach(item => {
                        const valRaw = row[item.index];
                        if (valRaw !== undefined && valRaw !== null && valRaw !== "") {
                            const valNum = parseFloat(String(valRaw).replace(",", "."));
                            if (!isNaN(valNum)) {
                                mapelObj[item.name] = valNum;
                                totalNilai += valNum;
                                jumlahMapel++;
                            }
                        }
                    });

                    const avg = jumlahMapel > 0 ? (totalNilai / jumlahMapel).toFixed(2) : "0";
                    let status = "Sangat Baik";
                    if (avg < 70) status = "Perlu Peningkatan";
                    else if (avg < 80) status = "Cukup Baik";

                    dataDitemukan = {
                        nis: rawNis,
                        nama: nama,
                        kelas: kelas,
                        walas: walas,
                        nilai: mapelObj,
                        total: totalNilai,
                        avg: avg,
                        status: status
                    };
                    break;
                }
            }

            tampilkanLoading(false);

            if (dataDitemukan) {
                renderDataSiswa(dataDitemukan);
            } else {
                tampilkanAlert(`NIS ${inputNis} tidak ditemukan dalam sistem!`, "error");
            }
        }

        function renderDataSiswa(data) {
            document.getElementById("resNama").innerText = data.nama;
            document.getElementById("resNis").innerText = data.nis;
            document.getElementById("resKelas").innerText = data.kelas;
            document.getElementById("resWalas").innerText = data.walas;
            document.getElementById("resRataRata").innerText = data.avg;
            document.getElementById("resTotal").innerText = data.total;
            document.getElementById("resStatus").innerText = data.status;

            const tbody = document.getElementById("tabelNilaiBody");
            tbody.innerHTML = "";

            for (const [mapel, nilai] of Object.entries(data.nilai)) {
                const persen = Math.min(100, Math.max(0, nilai));
                let colorClass = persen >= 85 ? "bg-emerald-500" : (persen < 70 ? "bg-amber-500" : "bg-blue-500");

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="py-3 px-4 font-medium text-slate-200">${mapel}</td>
                    <td class="py-3 px-4 text-center font-bold text-white">${nilai}</td>
                    <td class="py-3 px-4 hidden sm:table-cell">
                        <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden">
                            <div class="${colorClass} h-2.5 rounded-full" style="width: ${persen}%"></div>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            }

            document.getElementById("areaHasil").classList.remove("hidden");
        }

        function tampilkanLoading(show) {
            document.getElementById("loadingSpinner").classList.toggle("hidden", !show);
        }

        function tampilkanAlert(msg, type) {
            const alertEl = document.getElementById("pesanAlert");
            alertEl.className = `p-4 rounded-xl text-sm font-medium flex items-center gap-3 ${
                type === 'error' ? 'bg-rose-500/10 border border-rose-500/20 text-rose-400' : 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-400'
            }`;
            alertEl.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i><span>${msg}</span>`;
            alertEl.classList.remove("hidden");
        }

        function sembunyikanAlert() {
            document.getElementById("pesanAlert").classList.add("hidden");
        }
    </script>
</body>
