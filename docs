<!-- Tambahkan Canvas untuk Grafik di dalam area KHS -->
<div class="mt-6 p-4 bg-slate-800/40 rounded-xl border border-slate-700/50">
    <h3 class="text-sm font-semibold text-slate-300 mb-4 text-center">Grafik Radar Performa Mata Pelajaran</h3>
