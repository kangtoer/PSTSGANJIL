            const alertEl = document.getElementById("pesanAlert");
            alertEl.className = `p-4 rounded-xl text-xs font-medium ${type === 'error' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-700'}`;
            alertEl.innerText = msg;
            alertEl.classList.remove("hidden");
        }

        function sembunyikanAlert() {
            document.getElementById("pesanAlert").classList.add("hidden");
        }
    </script>
