Response: Memahami Masalah (Understanding the Request)
Senang sekali mendengarnya bahwa koneksi Apps Script backend Anda sudah berhasil terhubung!
Masalah yang Anda alami saat ini adalah:
Fungsi SpreadsheetApp.getActiveSpreadsheet().getActiveSheet(); yang kita gunakan sebelumnya hanya membaca sheet pertama/sheet aktif saja (misalnya hanya kelas 9A).
Anda ingin backend mencari NIS siswa secara menyeluruh di semua sheet kelas yang ada (9A, 9B, 9C, 8A, 8B, 7A, 7B, dll).
Overview Solusi (Solution Overview)
Iterasi Semua Sheet (getSheets()): Daripada hanya mengambil getActiveSheet(), kita akan menggunakan SpreadsheetApp.getActiveSpreadsheet().getSheets() untuk mendapatkan daftar semua sheet/tab di spreadsheet Anda.
Pencarian Melintas Sheet: Skrip akan menelusuri sheet satu per satu (mulai dari 9A, 9B, 9C, dst.).
Jika NIS ditemukan di salah satu sheet, skrip akan mengambil data nilai, mencatat nama kelas dari sheet tersebut, lalu langsung mengembalikan respon JSON.
Jika NIS tidak ditemukan di sheet pertama, skrip akan melanjutkannya ke sheet berikutnya hingga selesai.
Langkah 1: Kode Baru Backend Google Apps Script
Buka kembali Google Apps Script Anda, hapus seluruh kode lama, dan gantikan dengan kode baru berikut:
function doGet(e) {
  // Ambil parameter NIS dari request URL (contoh: ?nis=9911)
  var targetNis = e.parameter.nis ? String(e.parameter.nis).trim().replace(/\D/g, "") : "";

  if (!targetNis) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: "Parameter NIS tidak ditemukan."
    })).setMimeType(ContentService.MimeType.JSON);
  }

  // Ambil semua sheet/tab di Spreadsheet
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheets = ss.getSheets();
  var studentFound = null;

  // Loop setiap sheet (9A, 9B, 9C, 8A, 8B, 7A, 7B, dll)
  for (var s = 0; s < sheets.length; s++) {
    var sheet = sheets[s];
    var sheetName = sheet.getName().trim(); // Nama tab/sheet
    var data = sheet.getDataRange().getValues();

    if (data.length < 2) continue; // Lompati jika sheet kosong

    var headerRow = data[0];
    var nisIdx = -1, namaIdx = -1, kelasIdx = -1, walasIdx = -1;
    var mapelIndices = [];

    // Identifikasi letak kolom berdasarkan header di sheet ini
    for (var i = 0; i < headerRow.length; i++) {
      var title = String(headerRow[i]).trim().toUpperCase();
      if (title === "NIS") nisIdx = i;
      else if (title === "NAMA") namaIdx = i;
      else if (title === "KELAS") kelasIdx = i;
      else if (title === "WALAS" || title.indexOf("WALA") !== -1) walasIdx = i;
      else if (title !== "NO" && title.indexOf("TERBILANG") === -1 && title !== "") {
        mapelIndices.push({ index: i, name: String(headerRow[i]).trim() });
      }
    }

    // Posisi default jika tidak terdeteksi otomatis
    if (nisIdx === -1) nisIdx = 3;   // Kolom D
    if (namaIdx === -1) namaIdx = 1;  // Kolom B
    if (kelasIdx === -1) kelasIdx = 2; // Kolom C

    // Cari NIS di baris data sheet ini
    for (var r = 1; r < data.length; r++) {
      var row = data[r];
      var currentNis = row[nisIdx] ? String(row[nisIdx]).trim().replace(/\D/g, "") : "";

      if (currentNis === targetNis) {
        var mapelObj = {};
        var totalNilai = 0;
        var jumlahMapel = 0;

        for (var m = 0; m < mapelIndices.length; m++) {
          var item = mapelIndices[m];
          var valRaw = row[item.index];
          if (valRaw !== undefined && valRaw !== null && valRaw !== "") {
            var valNum = parseFloat(String(valRaw).replace(",", "."));
            if (!isNaN(valNum)) {
              mapelObj[item.name] = valNum;
              totalNilai += valNum;
              jumlahMapel++;
            }
          }
        }

        var avg = jumlahMapel > 0 ? (totalNilai / jumlahMapel).toFixed(2) : "0";
        var status = "Sangat Baik";
        if (avg < 70) status = "Perlu Peningkatan";
        else if (avg < 80) status = "Cukup Baik";

        // Jika kolom kelas di tabel kosong, gunakan nama tab sheet sebagai nama kelas
        var namaKelas = (kelasIdx !== -1 && row[kelasIdx]) ? String(row[kelasIdx]).trim() : sheetName;

        studentFound = {
          nis: currentNis,
          nama: row[namaIdx] ? String(row[namaIdx]).trim() : "-",
          kelas: namaKelas,
          walas: (walasIdx !== -1 && row[walasIdx]) ? String(row[walasIdx]).trim() : "-",
          nilai: mapelObj,
          total: totalNilai,
          avg: avg,
          status: status
        };

        break; // Keluar dari loop baris jika siswa ditemukan
      }
    }

    if (studentFound) break; // Keluar dari loop sheet jika siswa sudah ditemukan
  }

  // Pengembalian Respon JSON
  if (studentFound) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "success",
      data: studentFound
    })).setMimeType(ContentService.MimeType.JSON);
  } else {
    return ContentService.createTextOutput(JSON.stringify({
      status: "not_found",
      message: "NIS " + targetNis + " tidak ditemukan di semua sheet kelas."
    })).setMimeType(ContentService.MimeType.JSON);
  }
}


